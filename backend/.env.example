# Football Data API (free tier at https://www.football-data.org/)
FOOTBALL_API_KEY=your_football_data_api_key_here
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4

# Scorebat video feed — free token at https://www.scorebat.com/video-api/
# Without it, the video feed falls back to a frozen legacy sample whose
# embeds often show "video unavailable".
SCOREBAT_TOKEN=

# JWT Auth
SECRET_KEY=change-this-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite+aiosqlite:///./football_watch.db

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081
